# Gemini AI generation + embedding keys
# Configure up to five separate Gemini API keys/projects.
# The app rotates across them and fails over when one reaches a quota/rate limit.
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_API_KEY_4=your_gemini_api_key_4
GEMINI_API_KEY_5=your_gemini_api_key_5

# Optional legacy single-key compatibility (API #1 if numbered keys are absent)
# GEMINI_API_KEY=your_legacy_gemini_api_key

GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional real-time web research
TAVILY_API_KEY=your_tavily_api_key

# Optional enterprise RAG
PINECONE_API_KEY=
PINECONE_INDEX=editra
PINECONE_NAMESPACE=default
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
